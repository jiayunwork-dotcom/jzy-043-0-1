# TaskForge environment variables
POSTGRES_DSN=postgres://taskforge:taskforge@postgres:5432/taskforge?sslmode=disable
REDIS_ADDR=redis:6379
REDIS_PASSWORD=
REDIS_DB=0

# redis (default) or memory (memory is mainly used in unit tests)
QUEUE_DRIVER=redis

HTTP_ADDR=:8080
WORKER_COUNT=3
SLOTS_PER_WORKER=4
# After this many consecutive high-priority (Critical/High) dispatches,
# one dispatch opportunity is forced for Normal/Low/Bulk.
FAIRNESS_THRESHOLD=5
DISPATCH_INTERVAL=50ms
DELAY_SCAN_INTERVAL=250ms
HEARTBEAT_INTERVAL=3s
# A worker is declared lost after this duration without a heartbeat.
WORKER_TIMEOUT=15s
# Each running task acquires a lease renewed by its worker.
LEASE_TTL=15s
SHUTDOWN_TIMEOUT=30s
